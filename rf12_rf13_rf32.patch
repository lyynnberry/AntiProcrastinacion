 TAREA_EDITADA = "TAREA_EDITADA"
+TAREA_ESTADO_CAMBIADO = "TAREA_ESTADO_CAMBIADO"
+TAREA_COMPLETADA = "TAREA_COMPLETADA"
+TAREA_REABIERTA = "TAREA_REABIERTA"
+TAREA_POSPUESTA = "TAREA_POSPUESTA"
